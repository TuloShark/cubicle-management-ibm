# ================================================================================
# Cubicle Management System - Root Repository Git Exclusion Configuration
# ================================================================================
#
# @fileoverview Comprehensive Git version control exclusion patterns for the 
# complete Cubicle Management System monorepo. Covers frontend Vue.js application,
# backend Node.js API, Docker containers, development tools, and deployment 
# configurations for enterprise-grade workspace optimization solution.
#
# @version 2.0.0
# @author IBM Space Optimization Developer - Wander Jimenez Calvo
# @since 1.0.0
#
# Repository Structure:
# - /demo/frontend/     Vue.js TypeScript application with Vite build system
# - /demo/api/          Node.js Express API server with MongoDB integration
# - /docker-compose.yml Container orchestration for development and production
# - Documentation, configuration, and deployment files
#
# Purpose:
# - Exclude build artifacts and generated files from version control
# - Prevent sensitive configuration and environment files from being committed
# - Reduce repository size and improve clone/fetch performance across all components
# - Maintain clean development workflow and prevent merge conflicts
# - Optimize Docker build contexts and CI/CD pipeline efficiency
# - Support multi-developer team collaboration with consistent exclusions
#
# Repository Impact:
# - Typical size reduction: 85-95% of potential repository bloat
# - Clone time improvement: 70-85% faster repository operations
# - Security enhancement: Sensitive files and credentials excluded
# - Build optimization: Cleaner Docker build contexts for faster builds
# - Development efficiency: Reduced conflicts and cleaner file trees
#
# Pattern Syntax:
# - Use Unix-style glob patterns for cross-platform compatibility
# - Comments start with # for documentation and organization
# - Negation with ! to include files that would otherwise be excluded
# - Directory patterns end with / to match directories specifically
# - Use ** for recursive directory matching across subdirectories
# - Case-sensitive matching (use appropriate casing for cross-platform support)
#
# Maintenance Guidelines:
# - Review patterns quarterly for relevance and effectiveness
# - Add new patterns when introducing new tools, frameworks, or dependencies
# - Test exclusions with 'git check-ignore <file>' command before committing
# - Document rationale for complex or non-obvious patterns
# - Coordinate changes with team to ensure consistency across environments
# - Validate patterns work correctly on Windows, macOS, and Linux
#
# ================================================================================

# ================================================================================
# DEPENDENCIES AND PACKAGE MANAGEMENT
# ================================================================================
#
# Node.js dependency directories and package manager artifacts across all services
# These directories contain downloaded packages and should be regenerated from
# package.json/package-lock.json rather than tracked in version control
#
# Impact: Prevents massive dependency trees from bloating repository
# Security: Avoids potential security issues from committed dependencies
# Performance: Significantly reduces repository size and operation times
# Reproducibility: Ensures consistent dependency versions across environments
#

# Node.js dependency directories (frontend, API, and any tools)
node_modules/
demo/frontend/node_modules/
demo/api/node_modules/
tools/node_modules/
scripts/node_modules/

# Package manager debug and error logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Package manager cache and temporary directories
.npm/
.yarn/
.pnpm/
.yarn-integrity

# Package manager lock files metadata
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Runtime data and process identifiers
pids/
*.pid
*.seed
*.pid.lock

# Optional REPL history
.node_repl_history

# Output of 'npm pack' and distribution archives
*.tgz
*.tar.gz

# ================================================================================
# BUILD ARTIFACTS AND GENERATED FILES
# ================================================================================
#
# Files and directories created during build processes across all applications
# These are generated from source code and should not be version controlled
# Can be recreated using build commands (npm run build, docker build, etc.)
#
# Impact: Prevents build artifacts from causing merge conflicts
# Performance: Reduces repository size and improves build consistency
# Security: Avoids exposing compiled code with embedded configurations
# Automation: Ensures clean builds in CI/CD pipelines
#

# Vue.js / Vite build outputs (frontend application)
demo/frontend/dist/
demo/frontend/dist-ssr/
demo/frontend/.vite/

# Generic build and distribution directories
build/
dist/
dist-ssr/
out/
.out/

# TypeScript compilation cache and build info
*.tsbuildinfo
tsconfig.tsbuildinfo
.tsbuildinfo

# Compiled binary addons and native modules
build/Release/

# Bundler cache directories (various tools)
.cache/
.parcel-cache/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Framework-specific build outputs
.next/                    # Next.js
.nuxt/                    # Nuxt.js
.gatsby/                  # Gatsby
.storybook-out/          # Storybook
.docusaurus/             # Docusaurus

# Static site generator outputs
public/                   # Gatsby, Hugo, Jekyll (when used as build output)
_site/                   # Jekyll
.jekyll-cache/

# ================================================================================
# DEVELOPMENT AND DEBUGGING FILES
# ================================================================================
#
# Files generated during development, debugging, and testing processes
# These files are specific to individual developer environments
# Should not be shared between team members or deployed to production
#
# Impact: Prevents development artifacts from cluttering repository
# Security: Avoids exposing debugging information and local configurations
# Performance: Keeps repository focused on source code only
# Collaboration: Maintains clean shared development environment
#

# Application and system logs
logs/
*.log
demo/api/api.log
demo/api/logs/
demo/frontend/logs/

# Debug and profiling files
*.prof
*.cpuprofile
*.heapprofile
*.heapsnapshot

# Test coverage reports and output
coverage/
*.lcov
.nyc_output/
test-results/
test-reports/
junit.xml

# Linting and code quality cache files
.eslintcache
.prettiercache
.stylelintcache

# Editor and development tool cache
.vscode/.ropeproject/
.idea/workspace.xml
.idea/tasks.xml

# Temporary development files
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
*.orig

# ================================================================================
# ENVIRONMENT AND CONFIGURATION FILES
# ================================================================================
#
# Environment-specific configuration files containing sensitive information
# These files often contain API keys, database credentials, and other secrets
# Should be managed per environment and never committed to version control
#
# Security: Critical for preventing credential exposure and security breaches
# Flexibility: Allows different configurations for different environments
# Best Practice: Use environment variables and .env.example templates instead
# Compliance: Meets security requirements for enterprise deployments
#

# Environment variable files (all variants)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local

# Service-specific environment files
demo/frontend/.env.local
demo/api/.env.local
demo/api/.env

# Configuration overrides and local settings
config.local.js
config.local.json
config.local.yml
config.local.yaml

# Authentication and service account files
service-account.json
firebase-adminsdk-*.json
.serviceAccountKey.json

# SSL certificates and private keys
*.pem
*.key
*.crt
*.p12
*.pfx

# Database connection files
.sequelizerc.local
knexfile.local.js

