# Development environment configuration template
# Copy this file to .env.dev and configure with your values

# Firebase configuration - REQUIRED
VITE_API_KEY=your_firebase_api_key_here
VITE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_PROJECT_ID=your_project_id_here
VITE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_APP_ID=your_app_id_here
VITE_MEASUREMENT_ID=your_measurement_id_here

# Admin User IDs for frontend authorization - REQUIRED
# Comma-separated list of Firebase UIDs that have admin access
VITE_ADMIN_UIDS=uid1,uid2,uid3

# API Base URL for development (usually localhost)
VITE_API_BASE_URL=http://localhost:3000
